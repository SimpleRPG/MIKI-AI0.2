{
  "name": "miki-ai",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node build-server.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "check:imports": "node scripts/check_imports.mjs",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:native-runner": "bash scripts/install_android_native_runner.sh",
    "android:workmanager": "bash scripts/install_android_workmanager.sh",
    "android:verify-workmanager-contract": "tsx scripts/verify_android_workmanager_contract.ts",
    "android:verify-contract": "tsx scripts/verify_android_native_contract.ts",
    "android:prepare": "npx cap add android && bash scripts/install_android_native_runner.sh && bash scripts/install_android_japanese_morphology.sh && bash scripts/install_android_workmanager.sh && npx cap sync android",
    "android:verify-japanese-contract": "tsx scripts/verify_android_japanese_morphology_contract.ts",
    "android:verify-voice-contract": "tsx scripts/verify_android_voice_contract.ts",
    "verify:p0-gate": "bash scripts/run_p0_gate.sh"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@google/genai": "2.19.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/jszip": "^3.4.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
